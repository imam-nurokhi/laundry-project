// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatusEnum {
  PENDING
  PICKED_UP
  WASHING
  IRONING
  READY
  COMPLETED
}

enum DeliveryType {
  DROP_OFF
  PICKUP
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum Unit {
  KG
  PCS
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  address       String?
  role          Role      @default(CUSTOMER)
  password      String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ServiceCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  icon        String?
  items       ServiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ServiceItem {
  id          String          @id @default(cuid())
  name        String
  price       Float
  unit        Unit            @default(KG)
  description String?
  isActive    Boolean         @default(true)
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  status          OrderStatusEnum @default(PENDING)
  paymentStatus   PaymentStatus   @default(UNPAID)
  deliveryType    DeliveryType    @default(DROP_OFF)
  totalAmount     Float           @default(0)
  notes           String?
  isExpress       Boolean         @default(false)
  expressSurcharge Float          @default(0)
  items           OrderItem[]
  estimatedDone   DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model OrderItem {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceItemId String
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id])
  quantity      Float       @default(1)
  weight        Float?
  unitPrice     Float
  subtotal      Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
